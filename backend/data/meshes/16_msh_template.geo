Point(132) = {cx1, cy3+ry14, 0, lc2};
Point(133) = {cx1+radius14, cy3, 0, lc2};
Point(134) = {cx1, cy3-ry14, 0, lc2};
Point(135) = {cx1-radius14, cy3, 0, lc2};
// inclusion 15
ry15 = radius15*(1 - ellipticity*(1 - square));
Point(136) = {cx2, cy3, 0, lc3};
Point(137) = {cx2, cy3+ry15, 0, lc2};
Point(138) = {cx2+radius15, cy3, 0, lc2};
Point(139) = {cx2, cy3-ry15, 0, lc2};
