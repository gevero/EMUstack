// Template mesh geometry file for a 4 x 4 supercell of inclusions.
// Inclusion k sits in sub-cell (row, column) = ((k-1) div 4, (k-1) mod 4), counted from the
// top left. Circles by default; ellipticity squashes them along y; square = 1 makes squares
// of side diameterk. posx, posy move every inclusion towards the cell centre (normalized).
// Inclusion 1 is Physical Surface 2 (inclusion_a), all others Physical Surface 3 (inclusion_b).
// Generated by a script: change the generator, not this file, for structural changes.

// Force Gmsh to use legacy msh file format v2
Mesh.MshFileVersion = 2.2;

d = 1; // grating period
ff = 0;
period = 0; // (legacy: d_in_nm)
period_y = 0; // (legacy: dy_in_nm)
dy = period_y/period;
diameter1 = 0; // (legacy: d1)
diameter2 = 0; // (legacy: d2)
diameter3 = 0; // (legacy: d3)
diameter4 = 0; // (legacy: d4)
diameter5 = 0; // (legacy: d5)
diameter6 = 0; // (legacy: d6)
diameter7 = 0; // (legacy: d7)
diameter8 = 0; // (legacy: d8)
diameter9 = 0; // (legacy: d9)
diameter10 = 0; // (legacy: d10)
diameter11 = 0; // (legacy: d11)
diameter12 = 0; // (legacy: d12)
diameter13 = 0; // (legacy: d13)
diameter14 = 0; // (legacy: d14)
diameter15 = 0; // (legacy: d15)
diameter16 = 0; // (legacy: d16)
radius1 = (diameter1/(2*period))*d;
radius2 = (diameter2/(2*period))*d;
radius3 = (diameter3/(2*period))*d;
radius4 = (diameter4/(2*period))*d;
radius5 = (diameter5/(2*period))*d;
radius6 = (diameter6/(2*period))*d;
radius7 = (diameter7/(2*period))*d;
radius8 = (diameter8/(2*period))*d;
radius9 = (diameter9/(2*period))*d;
radius10 = (diameter10/(2*period))*d;
radius11 = (diameter11/(2*period))*d;
radius12 = (diameter12/(2*period))*d;
radius13 = (diameter13/(2*period))*d;
radius14 = (diameter14/(2*period))*d;
radius15 = (diameter15/(2*period))*d;
radius16 = (diameter16/(2*period))*d;
ellipticity = 0;
square = 0;
lc = 0; // 0.501 0.201 0.0701;
lc2 = lc/1; // on inclusion outlines
lc3 = lc/1; // inclusion centres
posx = 0;
posy = 0;

hy = dy; // Thickness: square profile => hy = d

cx0 = d*1/8+posx;
cx1 = d*3/8+posx;
cx2 = d*5/8-posx;
cx3 = d*7/8-posx;
cy0 = -hy*1/8-posy;
cy1 = -hy*3/8-posy;
cy2 = -hy*5/8+posy;
cy3 = -hy*7/8+posy;

// grid corners, edge points on the inclusion centre lines
Point(1) = {0, 0, 0, lc};
Point(2) = {d*1/4, 0, 0, lc};
Point(3) = {d*2/4, 0, 0, lc};
Point(4) = {d*3/4, 0, 0, lc};
Point(5) = {d, 0, 0, lc};
Point(6) = {0, -hy*1/4, 0, lc};
Point(7) = {d*1/4, -hy*1/4, 0, lc};
Point(8) = {d*2/4, -hy*1/4, 0, lc};
Point(9) = {d*3/4, -hy*1/4, 0, lc};
Point(10) = {d, -hy*1/4, 0, lc};
Point(11) = {0, -hy*2/4, 0, lc};
Point(12) = {d*1/4, -hy*2/4, 0, lc};
Point(13) = {d*2/4, -hy*2/4, 0, lc};
Point(14) = {d*3/4, -hy*2/4, 0, lc};
Point(15) = {d, -hy*2/4, 0, lc};
Point(16) = {0, -hy*3/4, 0, lc};
Point(17) = {d*1/4, -hy*3/4, 0, lc};
Point(18) = {d*2/4, -hy*3/4, 0, lc};
Point(19) = {d*3/4, -hy*3/4, 0, lc};
Point(20) = {d, -hy*3/4, 0, lc};
Point(21) = {0, -hy, 0, lc};
Point(22) = {d*1/4, -hy, 0, lc};
Point(23) = {d*2/4, -hy, 0, lc};
Point(24) = {d*3/4, -hy, 0, lc};
Point(25) = {d, -hy, 0, lc};
Point(26) = {0, cy0, 0, lc};
Point(27) = {d*1/4, cy0, 0, lc};
Point(28) = {d*2/4, cy0, 0, lc};
Point(29) = {d*3/4, cy0, 0, lc};
Point(30) = {d, cy0, 0, lc};
Point(31) = {0, cy1, 0, lc};
Point(32) = {d*1/4, cy1, 0, lc};
Point(33) = {d*2/4, cy1, 0, lc};
Point(34) = {d*3/4, cy1, 0, lc};
Point(35) = {d, cy1, 0, lc};
Point(36) = {0, cy2, 0, lc};
Point(37) = {d*1/4, cy2, 0, lc};
Point(38) = {d*2/4, cy2, 0, lc};
Point(39) = {d*3/4, cy2, 0, lc};
Point(40) = {d, cy2, 0, lc};
Point(41) = {0, cy3, 0, lc};
Point(42) = {d*1/4, cy3, 0, lc};
Point(43) = {d*2/4, cy3, 0, lc};
Point(44) = {d*3/4, cy3, 0, lc};
Point(45) = {d, cy3, 0, lc};
Point(46) = {cx0, 0, 0, lc};
Point(47) = {cx1, 0, 0, lc};
Point(48) = {cx2, 0, 0, lc};
Point(49) = {cx3, 0, 0, lc};
Point(50) = {cx0, -hy*1/4, 0, lc};
Point(51) = {cx1, -hy*1/4, 0, lc};
Point(52) = {cx2, -hy*1/4, 0, lc};
Point(53) = {cx3, -hy*1/4, 0, lc};
Point(54) = {cx0, -hy*2/4, 0, lc};
Point(55) = {cx1, -hy*2/4, 0, lc};
Point(56) = {cx2, -hy*2/4, 0, lc};
Point(57) = {cx3, -hy*2/4, 0, lc};
Point(58) = {cx0, -hy*3/4, 0, lc};
Point(59) = {cx1, -hy*3/4, 0, lc};
Point(60) = {cx2, -hy*3/4, 0, lc};
Point(61) = {cx3, -hy*3/4, 0, lc};
Point(62) = {cx0, -hy, 0, lc};
Point(63) = {cx1, -hy, 0, lc};
Point(64) = {cx2, -hy, 0, lc};
Point(65) = {cx3, -hy, 0, lc};

// inclusion 1
ry1 = radius1*(1 - ellipticity*(1 - square));
Point(66) = {cx0, cy0, 0, lc3};
Point(67) = {cx0, cy0+ry1, 0, lc2};
Point(68) = {cx0+radius1, cy0, 0, lc2};
Point(69) = {cx0, cy0-ry1, 0, lc2};
Point(70) = {cx0-radius1, cy0, 0, lc2};
// inclusion 2
ry2 = radius2*(1 - ellipticity*(1 - square));
Point(71) = {cx1, cy0, 0, lc3};
Point(72) = {cx1, cy0+ry2, 0, lc2};
Point(73) = {cx1+radius2, cy0, 0, lc2};
Point(74) = {cx1, cy0-ry2, 0, lc2};
Point(75) = {cx1-radius2, cy0, 0, lc2};
// inclusion 3
ry3 = radius3*(1 - ellipticity*(1 - square));
Point(76) = {cx2, cy0, 0, lc3};
Point(77) = {cx2, cy0+ry3, 0, lc2};
Point(78) = {cx2+radius3, cy0, 0, lc2};
Point(79) = {cx2, cy0-ry3, 0, lc2};
Point(80) = {cx2-radius3, cy0, 0, lc2};
// inclusion 4
ry4 = radius4*(1 - ellipticity*(1 - square));
Point(81) = {cx3, cy0, 0, lc3};
Point(82) = {cx3, cy0+ry4, 0, lc2};
Point(83) = {cx3+radius4, cy0, 0, lc2};
Point(84) = {cx3, cy0-ry4, 0, lc2};
Point(85) = {cx3-radius4, cy0, 0, lc2};
// inclusion 5
ry5 = radius5*(1 - ellipticity*(1 - square));
Point(86) = {cx0, cy1, 0, lc3};
Point(87) = {cx0, cy1+ry5, 0, lc2};
Point(88) = {cx0+radius5, cy1, 0, lc2};
Point(89) = {cx0, cy1-ry5, 0, lc2};
Point(90) = {cx0-radius5, cy1, 0, lc2};
// inclusion 6
ry6 = radius6*(1 - ellipticity*(1 - square));
Point(91) = {cx1, cy1, 0, lc3};
Point(92) = {cx1, cy1+ry6, 0, lc2};
Point(93) = {cx1+radius6, cy1, 0, lc2};
Point(94) = {cx1, cy1-ry6, 0, lc2};
Point(95) = {cx1-radius6, cy1, 0, lc2};
// inclusion 7
ry7 = radius7*(1 - ellipticity*(1 - square));
Point(96) = {cx2, cy1, 0, lc3};
Point(97) = {cx2, cy1+ry7, 0, lc2};
Point(98) = {cx2+radius7, cy1, 0, lc2};
Point(99) = {cx2, cy1-ry7, 0, lc2};
Point(100) = {cx2-radius7, cy1, 0, lc2};
// inclusion 8
ry8 = radius8*(1 - ellipticity*(1 - square));
Point(101) = {cx3, cy1, 0, lc3};
