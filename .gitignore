# Bytecode and runtime caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Packaging & Build
build/
dist/
*.egg-info/
.eggs/

# Legacy compiled Fortran artifacts (safety purge)
*.o
*.pyf
*.exe
*.a

# Transient mesh outputs & logs
*.mail
*.msh
backend/data/*.log
backend/data/*.mail
backend/data/*.msh
backend/data/meshes/*.log
backend/data/meshes/*.msh
backend/data/meshes/generated/
emustack_meshes/

# Never ignore checked-in test mail, msh, geo, and python template files
!backend/data/meshes/*.mail
!backend/data/meshes/*.msh
!backend/data/meshes/*.geo
!backend/data/meshes/*.py

# Never ignore materials databases
!backend/data/*.txt

# Backup files
*.bak
*.geo.bak

# Simulation output artifacts
*.pdf
Lay_*.txt
Lay_*.pdf
Absorptance_*.txt
Reflectance_*.txt
Transmittance_*.txt
Total_Spectra_*.pdf
1D_*.pdf
examples/*.txt
examples/*.pdf
examples/*.log
examples/*.npz
examples_netgen/*.txt
examples_netgen/*.pdf
examples_netgen/*.npz
test*/*.txt
test*/*.pdf
test*/*.npz

# Documentation build outputs
docs/*.tex
docs/*.aux
docs/*.log
docs/*.fdb_latexmk
docs/*.gz
docs/*.out
docs/*.toc
docs/build/
docs/source/examples/
docs/source/examples_netgen/

# Jupyter & Editor
.ipynb_checkpoints/
.DS_Store
*.swp
*~
.vscode/
.idea/
overrides.json
